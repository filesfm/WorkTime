#!/usr/bin/env bash
#
# Blocks `git commit` if clang-tidy (see .clang-tidy) or clang-format (see
# .clang-format) reports any problems in the C++ files staged for this
# commit.
#
# Enable once per clone with:
#   git config core.hooksPath hooks
#
# Bypass in an emergency with:
#   git commit --no-verify

set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1
# shellcheck source=hooks/lib.sh
source hooks/lib.sh

mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACMR -z -- src test)

cpp_files=()
format_files=()
for f in "${staged[@]}"; do
    case "$f" in
        *.cpp)
            format_files+=("$f")
            case "$f" in
                src/*) cpp_files+=("$f") ;;
            esac
            ;;
        *.hpp | *.mm) format_files+=("$f") ;;
    esac
done

status=0

if [ "${#cpp_files[@]}" -gt 0 ]; then
    require_clang_tidy || exit 1

    build_dir=$(find_build_dir) || {
        print_no_build_dir_help
        exit 1
    }

    echo "pre-commit: running clang-tidy on staged files using $build_dir ..."

    run_clang_tidy_on "$build_dir" "${cpp_files[@]}"
    if [ $? -ne 0 ]; then
        echo "" >&2
        echo "pre-commit: clang-tidy found problems above." >&2
        status=1
    fi
fi

if [ "${#format_files[@]}" -gt 0 ]; then
    require_clang_format || exit 1

    echo "pre-commit: checking clang-format conformance of staged files ..."

    run_clang_format_check_on "${format_files[@]}"
    if [ $? -ne 0 ]; then
        echo "" >&2
        echo "pre-commit: the files above are not clang-format-clean." >&2
        echo "Run: clang-format -i <file>..." >&2
        status=1
    fi
fi

if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: commit blocked. Fix the problems above, or bypass (not recommended) with: git commit --no-verify" >&2
fi

exit $status

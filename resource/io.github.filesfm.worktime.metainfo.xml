<component type="desktop-application">
  <id>io.github.filesfm.worktime</id>
  <name>WorkTime</name>
  <summary>A Qt6/QML desktop time-tracking app</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>Apache-2.0</project_license>
  <description>
    <p>
      WorkTime tracks working time with a simple Start/Stop button. It uses a
      system tray icon when one is available on the current desktop, falling
      back to a normal always-visible window otherwise, and configures a
      small settings table for server credentials, post interval, and
      screenshot capture options.
    </p>
  </description>
